<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xero_contact_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">xero.contact.sync.wizard.form</field>
        <field name="model">xero.contact.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Xero Contact Sync">
                <group>
                    <field name="operation" widget="radio"/>
                    <!-- <field name="xero_tenant_id" options="{'no_create': True, 'no_open': True}"/> -->
                </group>
                <footer>
                    <button name="action_confirm_sync" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="view_partner_form_inherit_xero" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.xero</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']/group" position="inside">
                 <group string="Xero Integration" name="xero_integration">
                    <field name="xero_contact_id"/>
                </group>
            </xpath>
        </field>
    </record>




    <record id="action_xero_contact_sync_wizard" model="ir.actions.act_window">
        <field name="name">Import / Export Contacts</field>
        <field name="res_model">xero.contact.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_xero_contacts"
        name="Import / Export Contacts"
        parent="menu_xero_root"
        action="action_xero_contact_sync_wizard"
        sequence="8"/>
</odoo>