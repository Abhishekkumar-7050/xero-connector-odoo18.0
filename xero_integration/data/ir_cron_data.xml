<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_xero_daily_sync" model="ir.cron">
            <field name="name">Xero: Daily Full Sync</field>
            <field name="model_id" ref="model_xero_api_connector"/>
            <field name="state">code</field>
            <field name="code">model.run_daily_sync()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>


          <record id="ir_cron_xero_refresh_token" model="ir.cron">
            <field name="name">Xero: Refresh Access Token</field>
            <field name="model_id" ref="model_xero_api_connector"/>
            <field name="state">code</field>
            <field name="code">model._refresh_xero_token()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">25</field>
            <field name="interval_type">minutes</field>
        </record>


    </data>
</odoo>